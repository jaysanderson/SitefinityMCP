# --- Sitefinity target -------------------------------------------------------
# Site origin (no trailing slash, no /api). Defaults to the EFTM2 demo instance.
SITEFINITY_BASE_URL=https://sta.eftm2.cloud.sitefinity.com
# OData service name. Stock Sitefinity exposes "default".
SITEFINITY_SERVICE_NAME=default

# --- Auth --------------------------------------------------------------------
# "anonymous" (public content) or "password" (OAuth2 password grant).
SITEFINITY_AUTH_MODE=anonymous
# Only when SITEFINITY_AUTH_MODE=password:
# SITEFINITY_USERNAME=user@example.com
# SITEFINITY_PASSWORD=your-password
# SITEFINITY_CLIENT_ID=sitefinity
# SITEFINITY_CLIENT_SECRET=

# --- Optional request defaults ----------------------------------------------
# SITEFINITY_DEFAULT_CULTURE=en
# SITEFINITY_SITE_ID=
# SITEFINITY_TIMEOUT_MS=30000

# --- Transport / hosting -----------------------------------------------------
# "http" (default, for hosting on Fly) or "stdio" (local MCP clients).
MCP_TRANSPORT=http
HOST=0.0.0.0
PORT=8080

# --- Optional AI assistant ---------------------------------------------------
# Enables the "Assistant" tab in the web UI (Claude answering via the MCP tools).
# SERVER-SIDE SECRET — never commit this or expose it to the browser.
# On Fly, set it with: fly secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
